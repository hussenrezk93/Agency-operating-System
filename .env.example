APP_NAME=Agency OS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# BRD: the system operates on Cairo time; step deadlines are always 23:59 Africa/Cairo.
APP_TIMEZONE=Africa/Cairo
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ---- PostgreSQL ----
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=agencyos
DB_USERNAME=agencyos
DB_PASSWORD=

# Separate database used by the test suite (see phpunit.xml).
DB_TEST_DATABASE=agencyos_test

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# APPROVED DECISION Q27 — provider-agnostic SMTP. Fill these from the company's
# official mail account at deployment time; never commit real credentials.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=
MAIL_FROM_ADDRESS="no-reply@example.test"
MAIL_FROM_NAME="Agency OS"

# APPROVED DECISION Q28 — email is queued; delivery never blocks a transition.
QUEUE_FAILED_DRIVER=database-uuids
