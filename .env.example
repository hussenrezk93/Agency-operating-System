APP_NAME=Agency OS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# BRD: the system operates on Cairo time; step deadlines are always 23:59 Africa/Cairo.
APP_TIMEZONE=Africa/Cairo
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ---- MySQL ----
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=agencyos
DB_USERNAME=agencyos
DB_PASSWORD=

# Separate database used by the test suite (see phpunit.xml).
DB_TEST_DATABASE=agencyos_test

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false

# Chat (BRD §14) real-time push. Free tier at pusher.com is enough for this app's scale
# (200k msgs/day, 100 concurrent connections). Falls back to no-op ('log') if unset.
BROADCAST_CONNECTION=pusher
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Groq-powered assistant widget ("Za'tar"). Get a free key at https://console.groq.com/keys
# (llama-3.1-8b-instant: 30 req/min, 14,400 req/day on the free tier).
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# APPROVED DECISION Q27 — provider-agnostic SMTP. Fill these from the company's
# official mail account at deployment time; never commit real credentials.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=
MAIL_FROM_ADDRESS="no-reply@example.test"
MAIL_FROM_NAME="Agency OS"

# APPROVED DECISION Q28 — email is queued; delivery never blocks a transition.
QUEUE_FAILED_DRIVER=database-uuids
